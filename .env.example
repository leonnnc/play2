# ============================================================
# Play2 - Variables de entorno
# Copia este archivo como .env  (en la raiz del repo)
# ============================================================

# --- Servidor / seguridad ---
PORT=4000
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173

# --- Datos ---
# Ruta del archivo de persistencia (por defecto apps/api/data/play2.json)
# DATA_FILE=./data/play2.json

# ============================================================
# PROVEEDORES DE BUSQUEDA
# Todos son OPCIONALES: la app funciona sin ninguna clave
# usando Apple Music / iTunes previews (no requiere clave).
# ============================================================

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/credentials  (habilita "YouTube Data API v3")
YOUTUBE_API_KEY=

# --- Spotify (Client Credentials) ---
# https://developer.spotify.com/dashboard  -> Create app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Debe coincidir exacto con el Redirect URI del dashboard de Spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/auth/spotify/callback
WEB_APP_URL=http://localhost:5173

# --- SoundCloud ---
# https://developers.soundcloud.com/  (apps nuevas requieren OAuth; usa el client_id de tu app)
SOUNDCLOUD_CLIENT_ID=

# --- Vimeo ---
# https://developer.vimeo.com/apps  -> Authentication -> Personal access token
VIMEO_ACCESS_TOKEN=

# --- iTunes / Apple Music previews ---
# No requiere clave. Solo cambia el pais de la tienda si lo necesitas.
ITUNES_COUNTRY=PE
