{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Play2",
  "version": "0.3.0",
  "identifier": "app.play2.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Play2",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Music",
    "shortDescription": "Musica cristiana",
    "longDescription": "Alabanzas, adoraciones, predicas y podcasts cristianos. Busca en YouTube, Spotify, SoundCloud, Vimeo y Apple Music.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
